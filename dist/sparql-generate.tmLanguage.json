{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "SPARQL-Generate",
  "scopeName": "source.sparql-generate",
  "fileTypes": [
    "rqg"
  ],
  "comment": "GENERATED by `npm run generate` (highlight-sparql-generate, src/textmate.js) from src/lexicon.js and the vendored stardog-rdf-grammars SPARQL and Turtle grammars (Apache-2.0). Do not edit.",
  "patterns": [
    {
      "include": "#sg-expression-node"
    },
    {
      "include": "#sg-iri"
    },
    {
      "include": "#sg-library"
    },
    {
      "include": "#sg-keywords"
    },
    {
      "include": "#sg-builtins"
    },
    {
      "include": "#sparql"
    }
  ],
  "repository": {
    "sg-expression-node": {
      "comment": "An expression node, ?{ expr } or ${ expr } (XExpr of spargl.jj).",
      "name": "meta.embedded.line.sparql-generate",
      "begin": "[?$]\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.sparql-generate"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.sparql-generate"
        }
      },
      "patterns": [
        {
          "include": "#sg-expression"
        }
      ]
    },
    "sg-interpolation": {
      "comment": "An expression embedded in a string or an IRI: { expr }.",
      "name": "meta.embedded.line.sparql-generate",
      "begin": "\\{",
      "beginCaptures": {
        "0": {
          "name": "punctuation.section.embedded.begin.sparql-generate"
        }
      },
      "end": "\\}",
      "endCaptures": {
        "0": {
          "name": "punctuation.section.embedded.end.sparql-generate"
        }
      },
      "patterns": [
        {
          "include": "#sg-expression"
        }
      ]
    },
    "sg-expression": {
      "comment": "The body of an embedded expression: SPARQL, braces balanced.",
      "patterns": [
        {
          "include": "#sg-group"
        },
        {
          "include": "$self"
        }
      ]
    },
    "sg-group": {
      "comment": "A group inside an embedded expression: { IF(EXISTS { ?s ?p ?o }, 1, 0) }.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#sg-expression"
        }
      ]
    },
    "sg-iri": {
      "comment": "An IRI with embedded expressions: <http://ex/{?id}> (XIRIref of spargl.jj).",
      "name": "entity.name.type.iriref.sparql-generate",
      "begin": "<(?=[^<>\"{}|^`\\\\\\x00-\\x20]*\\{)",
      "end": ">|(?=[\\s<\"|^`\\\\])",
      "patterns": [
        {
          "include": "#sg-interpolation"
        }
      ]
    },
    "sg-library": {
      "comment": "A function or iterator of the SPARQL-Generate libraries (fun:, iter:).",
      "name": "support.function.library.sparql-generate",
      "match": "(?<![\\w?$:.\\-])(?:fun|iter):[A-Za-z_](?:[\\w.\\-]*[\\w\\-])?"
    },
    "sg-keywords": {
      "comment": "The keywords SPARQL-Generate adds to SPARQL 1.1.",
      "name": "keyword.control.sparql-generate",
      "match": "(?i)(?<![\\w?$:.\\-])(?:generate|template|perform|function|iterator|source|accept|box|format|before|after|list|expressions|pragma)(?![\\w\\-:])"
    },
    "sg-builtins": {
      "comment": "The built-in calls SPARQL-Generate adds to SPARQL 1.1: RAISE(message, value, ...).",
      "name": "support.function.builtin.sparql-generate",
      "match": "(?i)(?<![\\w?$:.\\-])(?:raise)(?![\\w\\-:])"
    },
    "turtle-prefix": {
      "name": "keyword.operator.turtle",
      "match": "(?i:@?base|@?prefix)\\s"
    },
    "turtle-iriref": {
      "name": "entity.name.type.iriref.turtle",
      "match": "<[^\\x20-\\x20<>\"{}|^`\\\\]*>"
    },
    "turtle-prefixed-name": {
      "name": "constant.complex.turtle",
      "match": "(\\w*:)(\\w*)",
      "captures": {
        "1": {
          "name": "storage.type.PNAME_NS.turtle"
        },
        "2": {
          "name": "support.variable.PN_LOCAL.turtle"
        }
      }
    },
    "turtle-comment": {
      "name": "comment.line.number-sign.turtle",
      "match": "#.*$"
    },
    "turtle-special-predicate": {
      "name": "meta.specialPredicate.turtle",
      "match": "\\s(a)\\s",
      "captures": {
        "1": {
          "name": "keyword.control.turtle"
        }
      }
    },
    "turtle-literals": {
      "patterns": [
        {
          "include": "#turtle-string"
        },
        {
          "include": "#turtle-numeric"
        },
        {
          "include": "#turtle-boolean"
        }
      ]
    },
    "turtle-string": {
      "patterns": [
        {
          "include": "#turtle-triple-squote-string-literal"
        },
        {
          "include": "#turtle-triple-dquote-string-literal"
        },
        {
          "include": "#turtle-single-squote-string-literal"
        },
        {
          "include": "#turtle-single-dquote-string-literal"
        },
        {
          "include": "#turtle-triple-tick-string-literal"
        }
      ]
    },
    "turtle-single-squote-string-literal": {
      "name": "string.quoted.single.turtle",
      "begin": "'",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.turtle"
        }
      },
      "end": "'",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.turtle"
        },
        "2": {
          "name": "invalid.illegal.newline.turtle"
        }
      },
      "patterns": [
        {
          "include": "#sg-interpolation"
        },
        {
          "include": "#turtle-string-character-escape"
        }
      ]
    },
    "turtle-single-dquote-string-literal": {
      "name": "string.quoted.double.turtle",
      "begin": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.turtle"
        }
      },
      "end": "\"",
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.turtle"
        }
      },
      "patterns": [
        {
          "include": "#sg-interpolation"
        },
        {
          "include": "#turtle-string-character-escape"
        }
      ]
    },
    "turtle-triple-squote-string-literal": {
      "name": "string.quoted.triple.turtle",
      "begin": "'''",
      "end": "'''",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.turtle"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.turtle"
        }
      },
      "patterns": [
        {
          "include": "#sg-interpolation"
        },
        {
          "include": "#turtle-string-character-escape"
        }
      ]
    },
    "turtle-triple-dquote-string-literal": {
      "name": "string.quoted.triple.turtle",
      "begin": "\"\"\"",
      "end": "\"\"\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.turtle"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.turtle"
        }
      },
      "patterns": [
        {
          "include": "#sg-interpolation"
        },
        {
          "include": "#turtle-string-character-escape"
        }
      ]
    },
    "turtle-triple-tick-string-literal": {
      "name": "string.quoted.triple.turtle",
      "begin": "```",
      "end": "```",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.turtle"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.turtle"
        }
      },
      "patterns": [
        {
          "include": "#turtle-string-character-escape"
        }
      ]
    },
    "turtle-string-character-escape": {
      "name": "constant.character.escape.turtle",
      "match": "\\\\(x\\h{2}|[0-2][0-7]{0,2}|3[0-6][0-7]?|37[0-7]?|[4-7][0-7]?|.|$)"
    },
    "turtle-numeric": {
      "patterns": [
        {
          "include": "#turtle-integer"
        }
      ]
    },
    "turtle-integer": {
      "name": "constant.numeric.turtle",
      "match": "[+-]?(?:\\d+|[0-9]+\\.[0-9]*|\\.[0-9]+(?:[eE][+-]?\\d+)?)"
    },
    "turtle-boolean": {
      "name": "constant.language.sparql",
      "match": "\\b(?i:true|false)\\b"
    },
    "turtle-language-tag": {
      "name": "meta.string-literal-language-tag.turtle",
      "match": "@(\\w+)",
      "captures": {
        "1": {
          "name": "entity.name.class.turtle"
        }
      }
    },
    "turtle-rule-constraint": {
      "name": "meta.rule-constraint.turtle",
      "begin": "(rule:content) (\"\"\")",
      "beginCaptures": {
        "1": {
          "patterns": [
            {
              "include": "#turtle-prefixed-name"
            }
          ]
        },
        "2": {
          "name": "string.quoted.triple.turtle"
        }
      },
      "end": "\"\"\"",
      "endCaptures": {
        "0": {
          "name": "string.quoted.triple.turtle"
        }
      },
      "patterns": []
    },
    "turtle": {
      "patterns": [
        {
          "include": "#turtle-rule-constraint"
        },
        {
          "include": "#turtle-iriref"
        },
        {
          "include": "#turtle-prefix"
        },
        {
          "include": "#turtle-prefixed-name"
        },
        {
          "include": "#turtle-comment"
        },
        {
          "include": "#turtle-special-predicate"
        },
        {
          "include": "#turtle-literals"
        },
        {
          "include": "#turtle-language-tag"
        }
      ]
    },
    "sparql-query-keyword-operators": {
      "name": "keyword.control.sparql",
      "match": "\\b(?i:define|select|distinct|reduced|from|named|construct|ask|describe|where|graph|having|bind|as|filter|optional|union|order|by|group|limit|offset|values|insert data|delete data|with|delete|insert|clear|silent|default|all|create|drop|copy|move|add|to|using|service|not exists|exists|not in|in|minus|load)\\b"
    },
    "sparql-functions": {
      "name": "support.function.sparql",
      "match": "\\b(?i:concat|regex|asc|desc|bound|isiri|isuri|isblank|isliteral|isnumeric|str|lang|datatype|sameterm|langmatches|avg|count|group_concat|separator|max|min|sample|sum|iri|uri|bnode|strdt|uuid|struuid|strlang|strlen|substr|ucase|lcase|strstarts|strends|contains|strbefore|strafter|encode_for_uri|replace|abs|round|ceil|floor|rand|now|year|month|day|hours|minutes|seconds|timezone|tz|md5|sha1|sha256|sha384|sha512|coalesce|if)\\b"
    },
    "sparql-variables": {
      "name": "constant.variable.sparql.turtle",
      "match": "(?<!\\w)[?$]\\w+"
    },
    "sparql-expression-operators": {
      "name": "support.class.sparql",
      "match": "(?:\\|\\||&&|=|!=|<|>|<=|>=|\\*|/|\\+|-|\\||\\^|\\?|\\!)"
    },
    "sparql": {
      "patterns": [
        {
          "include": "#turtle"
        },
        {
          "include": "#sparql-query-keyword-operators"
        },
        {
          "include": "#sparql-functions"
        },
        {
          "include": "#sparql-variables"
        },
        {
          "include": "#sparql-expression-operators"
        }
      ]
    }
  }
}
